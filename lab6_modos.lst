     1                                  ; lab6_modos.asm -- Demostracion de modos de direccionamiento x86
     2                                  ; Compilar: nasm -f bin lab6_modos.asm -o lab6_modos.com
     3                                  ;
     4                                  ; Programa .COM (org 100h). Crea un array de 5 enteros de 16 bits y un registro de
     5                                  ; 3 campos, y los accede con modos de direccionamiento distintos. El objetivo no es
     6                                  ; el resultado del calculo sino que cada modo produzca una direccion efectiva (EA)
     7                                  ; verificable con DEBUG:
     8                                  ;   inmediato  : el operando va dentro de la instruccion
     9                                  ;   directo    : EA = desplazamiento fijo en la instruccion
    10                                  ;   indirecto  : EA = registro (BX, SI, DI o BP)
    11                                  ;   indexado   : EA = base + indice + desplazamiento
    12                                  
    13                                  org 100h                        ; offset de inicio para archivos .COM
    14                                  
    15                                  ; --- Datos de prueba -----------------------------------------------------------
    16 00000000 EB34                        jmp inicio                  ; saltar sobre los datos hacia el codigo
    17                                  
    18                                  ; Array de 5 enteros de 16 bits (2 bytes por elemento, little-endian)
    19 00000002 0A0014001E00280032-     array    dw 10, 20, 30, 40, 50
    19 0000000B 00                 
    20                                  
    21                                  ; Registro de estudiante: nota1 (16 bits) + nota2 (16 bits) + promedio (16 bits)
    22 0000000C 5500                    nota1    dw 85                  ; offset 0 del registro
    23 0000000E 4900                    nota2    dw 73                  ; offset 2
    24 00000010 0000                    promedio dw 0                   ; offset 4
    25                                  
    26                                  ; Variable simple para el direccionamiento directo
    27 00000012 FFFF                    var_x    dw 0FFFFh
    28                                  
    29                                  ; Tabla de bytes (digitos hexadecimales en ASCII)
    30 00000014 3031323334353637        tabla_hex db 30h, 31h, 32h, 33h, 34h, 35h, 36h, 37h
    31 0000001C 3839414243444546                  db 38h, 39h, 41h, 42h, 43h, 44h, 45h, 46h
    32                                  
    33                                  ; Matriz de 3 filas x 3 columnas de enteros de 16 bits (3 elementos por fila)
    34                                  ; Direccion del elemento [fila][columna] = matriz + fila * 6 + columna * 2
    35 00000024 010002000300            matriz   dw 1, 2, 3
    36 0000002A 040005000600                     dw 4, 5, 6
    37 00000030 070008000900                     dw 7, 8, 9
    38                                  
    39                                  ; --- Codigo --------------------------------------------------------------------
    40                                  inicio:
    41                                  
    42                                  ; === MODO 1: INMEDIATO ==========================================================
    43                                  ; El operando es una constante incluida en el codigo de la instruccion: no se
    44                                  ; accede a memoria de datos. En DEBUG, U muestra el valor dentro del opcode.
    45                                  modo1_inmediato:
    46 00000036 B86400                      mov ax, 100                 ; AX = 100 (inmediato decimal; opcode B8 6400)
    47 00000039 BBA500                      mov bx, 0A5h                ; BX = 0A5h (inmediato hexadecimal)
    48 0000003C 83C137                      add cx, 55                  ; CX += 55 (inmediato en una operacion aritmetica)
    49 0000003F 81E2FF00                    and dx, 00FFh               ; DX AND mascara inmediata
    50                                  
    51                                  ; === MODO 2: DIRECTO ============================================================
    52                                  ; La direccion del operando esta fija en la instruccion (EA = 0100h + offset
    53                                  ; del simbolo, calculada al ensamblar). Los corchetes indican acceso a memoria.
    54                                  modo2_directo:
    55 00000043 A1[1200]                    mov ax, [var_x]             ; AX = mem[var_x] = 0FFFFh
    56 00000046 8B1E[0200]                  mov bx, [array]             ; BX = mem[array] = 10 (primer elemento)
    57 0000004A 8B0E[0C00]                  mov cx, [nota1]             ; CX = mem[nota1] = 85
    58                                  
    59                                      ; Escritura directa en memoria
    60 0000004E C706[1200]0000              mov word [var_x], 0         ; mem[var_x] = 0
    61                                  
    62                                  ; === MODO 3: INDIRECTO POR REGISTRO =============================================
    63                                  ; El registro contiene la direccion del operando; el puntero puede cambiar en
    64                                  ; tiempo de ejecucion. EA = SI.
    65                                  modo3_indirecto:
    66 00000054 BE[0C00]                    mov si, nota1               ; SI = direccion de nota1 (no su valor)
    67 00000057 8B04                        mov ax, [si]                ; AX = mem[SI] = 85
    68                                  
    69 00000059 BE[0E00]                    mov si, nota2               ; SI = direccion de nota2
    70 0000005C 8B1C                        mov bx, [si]                ; BX = mem[SI] = 73
    71                                  
    72                                      ; Promedio calculado con punteros
    73 0000005E 01D8                        add ax, bx                  ; AX = 85 + 73 = 158
    74 00000060 D1E8                        shr ax, 1                   ; AX = 158 / 2 = 79
    75 00000062 BE[1000]                    mov si, promedio            ; SI = direccion de promedio
    76 00000065 8904                        mov [si], ax                ; mem[SI] = 79 (guarda el promedio por el puntero)
    77                                  
    78                                  ; === MODO 4: INDEXADO (BASE + INDICE + DESPLAZAMIENTO) ===========================
    79                                  ; EA = base + indice + desplazamiento.
    80                                  modo4_indexado:
    81                                      ; Elemento especifico: array[2] = 30
    82 00000067 BB[0200]                    mov bx, array               ; BX = direccion base del array
    83 0000006A BE0400                      mov si, 4                   ; SI = indice * tamano del elemento = 2 * 2 = 4
    84 0000006D 8B00                        mov ax, [bx + si]           ; AX = mem[BX + SI] = array[2] = 30
    85                                  
    86                                      ; Suma de todos los elementos del array
    87 0000006F 31C0                        xor ax, ax                  ; AX = 0 (acumulador)
    88 00000071 BB[0200]                    mov bx, array               ; BX = direccion base
    89 00000074 B90500                      mov cx, 5                   ; CX = numero de elementos
    90 00000077 31F6                        xor si, si                  ; SI = 0 (indice en bytes)
    91                                  
    92                                  .bucle_array:
    93 00000079 0300                        add ax, [bx + si]           ; AX += array[SI / 2]
    94 0000007B 83C602                      add si, 2                   ; avanzar 2 bytes (un word)
    95 0000007E E2F9                        loop .bucle_array           ; AX = 10+20+30+40+50 = 150 = 96h al terminar
    96                                  
    97                                      ; Extension: recorrido inverso, de array[4] hacia array[0]
    98                                      ; Mismo modo indexado, pero SI parte del ultimo elemento y se decrementa de 2 en 2.
    99 00000080 31C0                        xor ax, ax                  ; AX = 0 (acumulador)
   100 00000082 BB[0200]                    mov bx, array               ; BX = direccion base
   101 00000085 B90500                      mov cx, 5                   ; CX = numero de elementos
   102 00000088 BE0800                      mov si, 8                   ; SI = 4 * 2 = desplazamiento en bytes de array[4]
   103                                  
   104                                  .bucle_array_inverso:
   105 0000008B 0300                        add ax, [bx + si]           ; AX += array[SI / 2], empezando por array[4]
   106 0000008D 83EE02                      sub si, 2                   ; retroceder 2 bytes (un word)
   107 00000090 E2F9                        loop .bucle_array_inverso   ; AX = 50+40+30+20+10 = 150 = 96h al terminar
   108                                  
   109                                      ; Campos del registro con desplazamiento fijo (base + desplazamiento)
   110 00000092 BB[0C00]                    mov bx, nota1               ; BX = base del registro (nota1, nota2, promedio)
   111 00000095 8B07                        mov ax, [bx]                ; AX = nota1 = 85 (offset 0)
   112 00000097 8B4F02                      mov cx, [bx + 2]            ; CX = nota2 = 73 (offset 2)
   113 0000009A 8B5704                      mov dx, [bx + 4]            ; DX = promedio = 79 (offset 4)
   114                                  
   115                                  ; === MODO 3b: INDIRECTO POR REGISTRO BP -- marco de variables locales ============
   116                                  ; BP es el registro base convencional para datos relativos a la pila: por defecto
   117                                  ; direcciona el segmento SS, mientras que BX/SI/DI direccionan DS. En un .COM
   118                                  ; ambos segmentos coinciden, por lo que el resultado observable es el mismo.
   119                                  modo3b_marco_bp:
   120 0000009D 55                          push bp                     ; preservar el BP del programa principal
   121 0000009E 89E5                        mov bp, sp                  ; BP = SP: define la base del nuevo marco de pila
   122 000000A0 83EC04                      sub sp, 4                   ; reservar 4 bytes (2 palabras) para variables locales
   123                                  
   124                                      ; Variables locales: desplazamientos negativos respecto a BP (EA = BP + desp.)
   125 000000A3 C746FE6300                  mov word [bp - 2], 99       ; local_1 = 99  (EA = BP - 2)
   126 000000A8 C746FCFA00                  mov word [bp - 4], 250      ; local_2 = 250 (EA = BP - 4)
   127                                  
   128 000000AD 8B46FE                      mov ax, [bp - 2]            ; AX = mem[BP - 2] = local_1 = 99
   129 000000B0 0346FC                      add ax, [bp - 4]            ; AX += local_2 = 99 + 250 = 349 = 015Dh
   130                                  
   131                                      ; Liberar el marco y restaurar BP antes de continuar
   132 000000B3 89EC                        mov sp, bp                  ; SP = BP: libera las variables locales
   133 000000B5 5D                          pop bp                      ; restaurar el BP del programa principal
   134                                  
   135                                  ; === ACCESO A MATRIZ: DOBLE INDEXACION (fila, columna) ===========================
   136                                  ; Elemento buscado: matriz[1][2] = 6
   137                                  ; EA = base + (fila * ancho_de_fila_en_bytes) + (columna * tamano_del_elemento)
   138                                  acceso_matriz:
   139 000000B6 B80100                      mov ax, 1                   ; AX = fila = 1
   140 000000B9 BB0300                      mov bx, 3                   ; BX = ancho de fila = 3 elementos (3 columnas)
   141 000000BC F7E3                        mul bx                      ; AX = fila * ancho_fila = 1 * 3 = 3 (en elementos)
   142 000000BE D1E0                        shl ax, 1                   ; AX = 3 * 2 bytes = 6 (desplazamiento de fila, en bytes)
   143 000000C0 89C6                        mov si, ax                  ; SI = desplazamiento de fila ya calculado
   144                                  
   145 000000C2 B90200                      mov cx, 2                   ; CX = columna = 2
   146 000000C5 D1E1                        shl cx, 1                   ; CX = 2 * 2 bytes = 4 (desplazamiento de columna, en bytes)
   147 000000C7 01CE                        add si, cx                  ; SI = desplazamiento total = 6 + 4 = 10 = 0Ah
   148                                  
   149 000000C9 BB[2400]                    mov bx, matriz              ; BX = direccion base de la matriz
   150 000000CC 8B10                        mov dx, [bx + si]           ; DX = mem[BX + SI] = matriz[1][2] = 6
   151                                  
   152                                  ; --- Fin del programa ----------------------------------------------------------
   153                                  fin_programa:
   154 000000CE CD20                        int 20h                     ; retornar a DOS
